# ---------------------------------------------------------------------------
# Hermes Console — environment variables (EXAMPLE)
#
# NOTE: Electron does NOT load a .env file automatically.
# These are ordinary process environment variables. Copy this file to `.env`
# only if you use a launcher that exports them; otherwise `set` them in your
# shell (cmd) before starting the console:
#
#   set HERMES_HOME=D:\hermes
#   electron.exe
#
# NEVER commit a populated copy of this file.
# ---------------------------------------------------------------------------

# Hermes home directory. If unset, the console looks for
# %LOCALAPPDATA%\hermes and uses it when it exists.
HERMES_HOME=D:\hermes

# Optional: one extra project directory shown on the "Extensions" page
# (read-only install status + directory shortcut). Leave unset when unused;
# the page will report "not installed" instead of guessing.
# HERMES_CONSOLE_EXTRA_DIR=

# Optional: override the hermes executable. By default the console looks for
# <HERMES_HOME>\hermes-agent\venv\Scripts\hermes.exe, then <HERMES_HOME>\bin\hermes.exe,
# then falls back to whatever `hermes` resolves to on PATH.
# HERMES_CONSOLE_HERMES_EXE=
